# Required for production. Use at least 32 random characters.
OLFACTUS_SESSION_SECRET=replace-with-a-long-random-production-secret

# Local server persistence directory. Defaults to ./.olfactus-data
OLFACTUS_DATA_DIR=./.olfactus-data

# Reserved for the production PostgreSQL adapter.
DATABASE_URL=postgresql://user:password@host:5432/olfactus
